table _medidas
	lineageTag: cc99d097-dbe7-4ac8-8a40-92bc399de1c0

	measure 'Total de Pedidos' = COUNTROWS('fato_entrega')
		formatString: #,0
		displayFolder: Fato entrega\Contadores Base
		lineageTag: 6948c3f7-7bc7-43fc-8dfc-a16f50fefaf3

	measure 'Pedidos Entregues' = ```
			
				CALCULATE(
					[Total de Pedidos],
					NOT ISBLANK(
						fato_entrega[entregue_no_prazo]
					)
				)
			```
		formatString: #,0
		displayFolder: Fato entrega\Contadores Base
		lineageTag: 997cac0a-2008-4160-9bb8-67c0e4f6d87c

	measure 'Pedidos no Prazo' = ```
			
				CALCULATE(
					[Total de Pedidos],
					fato_entrega[entregue_no_prazo] = TRUE
				)
			```
		formatString: #,0
		displayFolder: Fato entrega\Contadores Base
		lineageTag: e6eb53ee-33c8-44ce-8023-39b5f0c7f9ad

	measure 'Pedidos Cancelados' = ```
			
				CALCULATE(
					[Total de Pedidos],
					fato_entrega[status_pedido] = "canceled"
				)
			```
		formatString: #,0
		displayFolder: Fato entrega\Contadores Base
		lineageTag: 41200931-58c8-4fd1-927b-3dfc15854aca

	measure 'OTD %' = ```
			
				DIVIDE(
					[Pedidos no Prazo],
					[Pedidos Entregues],
					0
				)
			```
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Fato entrega\Medidas Centrais
		lineageTag: 5e737880-9053-4fda-94d5-f08d228ebeee

	measure 'Lead Time Médio' = ```
			
				AVERAGE(fato_entrega[lead_time_dias])
			```
		formatString: #,0.0
		displayFolder: Fato entrega\Medidas Centrais
		lineageTag: fc86c08d-6dce-44b9-9f3d-d2ad974856b4

	measure 'Lead Time Mediano' = ```
			
				MEDIAN(fato_entrega[lead_time_dias])
			```
		formatString: #,0.0
		displayFolder: Fato entrega\Medidas Centrais
		lineageTag: e5d7f150-978e-45f1-bc8a-a16bc673c989

	measure 'Valor de Itens' = ```
			
				SUM(fato_entrega[valor_itens])
					
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Fato entrega\Financeiro
		lineageTag: 1ba5a774-7ab3-440c-b736-add20a462b77

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Valor de Frete' = ```
			
				SUM(fato_entrega[valor_frete])
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Fato entrega\Financeiro
		lineageTag: 13e7250c-a2fd-49e5-b86a-0297ea876292

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Ticket Médio' = ```
			
				DIVIDE(
					[Valor de Itens],
					[Total de Pedidos],
					0
				)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Fato entrega\Financeiro
		lineageTag: cf11f1ef-da64-413d-a4be-f13ad542e9af

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Frete sobre Faturamento' = ```
			
				DIVIDE(
					[Valor de Frete],
					[Valor de Itens],
					0
				)
			```
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Fato entrega\Medidas Centrais
		lineageTag: 3391b69e-decd-4034-a21a-b5f4dacad6e6

	measure 'Dias até Aprovação (méd)' = ```
			
				AVERAGE(
					fato_entrega[dias_ate_aprovacao]
				)
			```
		formatString: #,0.0
		displayFolder: Fato entrega\Decomposição de Atraso
		lineageTag: cbb59afe-3799-4d76-a677-8d84ac19c446

	measure 'Dias até Coleta (méd)' = ```
			
				AVERAGE(
					fato_entrega[dias_ate_coleta]
				)
			```
		formatString: #,0.0
		displayFolder: Fato entrega\Decomposição de Atraso
		lineageTag: e43ac025-7421-45c7-a243-b6ff3d6caac5

	measure 'Dias de Transporte (méd)' = ```
			
				CALCULATE(
					AVERAGEX(
						fato_entrega,
						fato_entrega[lead_time_dias] - fato_entrega[dias_ate_coleta]),
						NOT ISBLANK(
							fato_entrega[entregue_no_prazo]
						)
				)
			```
		formatString: #,0.0
		displayFolder: Fato entrega\Decomposição de Atraso
		lineageTag: b518bfcc-7feb-4720-8eaf-6c64669cc969

	measure 'Dias de Atraso (méd)' = ```
			
				CALCULATE(
					AVERAGE(fato_entrega[dias_de_atraso]),
					fato_entrega[dias_de_atraso] > 0
				)
			
			```
		formatString: #,0.0
		displayFolder: Fato entrega\Decomposição de Atraso
		lineageTag: f810f7ab-3e68-4184-88ed-65bdb2b7de7c

	measure 'Nota Média' = AVERAGE(fato_entrega[nota])
		formatString: #,0.00
		displayFolder: Fato entrega\Avaliações
		lineageTag: 1f3092f9-1199-4321-90db-5efe54329a41

	measure 'Pedidos Entregues (por Data de Entrega)' = ```
			
				CALCULATE(
					[Pedidos Entregues],
					USERELATIONSHIP(
						fato_entrega[sk_data_entrega],
						dim_calendario[sk_data]
					)
				)
			```
		formatString: 0
		displayFolder: Fato entrega\Troca Relacionamento
		lineageTag: 9051da9b-f3be-4378-aee3-27db7bc22204

	measure 'OTD % (por Data de Entrega)' =
			
			CALCULATE(
			    [OTD %],
			    USERELATIONSHIP(fato_entrega[sk_data_entrega], dim_calendario[sk_data])
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: Fato entrega\Troca Relacionamento
		lineageTag: 68ea6516-91d9-4316-b8bf-1c9be3cbb284

	measure 'Valor de Frete (Item)' = SUM(fato_item_pedido[valor_frete])
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Fato item pedido\Financeiro e Frete
		lineageTag: 3d1b1f72-d21b-4934-bc00-1d7a5ca88eeb

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Peso Total (kg)' = SUM(fato_item_pedido[peso_gramas]) / 1000
		formatString: #,0.00
		displayFolder: Fato item pedido\Financeiro e Frete
		lineageTag: 165bef96-38fc-4b64-8219-745c9c6bff74

	measure 'Custo por Quilo' = ```
			
				DIVIDE(
					[Valor de Frete (Item)],
					[Peso Total (kg)],
					0
				)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Fato item pedido\Financeiro e Frete
		lineageTag: be5ed125-eeca-4a10-8fc3-9f1f98432557

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Dias de Atraso (méd) por Vendedor' = ```
			
				CALCULATE(
					[Dias de Atraso (méd)],
					TREATAS(
						VALUES(fato_item_pedido[sk_pedido]),
						fato_entrega[sk_pedido]
					)
				)
			```
		formatString: #,0.0
		displayFolder: Fato item pedido\Ponte Virtual
		lineageTag: d978d479-7a24-4e29-a529-dd753283f40b

	measure 'Peso Total (kg) por Rota' = ```

				CALCULATE(
					[Peso Total (kg)],
					TREATAS(
						VALUES(fato_entrega[sk_pedido]),
						fato_item_pedido[sk_pedido]
					)
				)
			```
		formatString: #,0.00
		displayFolder: Fato item pedido\Ponte Virtual
		lineageTag: 621e8f6b-8081-49fc-9eac-5fb1d9ce6818

	measure 'Custo por Quilo (por Rota)' = ```

				DIVIDE(
					[Valor de Frete],
					[Peso Total (kg) por Rota],
					0
				)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Fato item pedido\Ponte Virtual
		lineageTag: 4763684e-ae77-421a-bb20-0638afdfc944

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Rota Mais Cara por Kg' = ```

				VAR Ranking =
					ADDCOLUMNS(
						SUMMARIZE(fato_entrega, fato_entrega[rota]),
						"@CustoKg", [Custo por Quilo (por Rota)]
					)
				VAR RotaTop =
					TOPN(1, FILTER(Ranking, NOT ISBLANK(fato_entrega[rota]) && [@CustoKg] > 0), [@CustoKg], DESC)
				RETURN
					MAXX(RotaTop, fato_entrega[rota])
			```
		displayFolder: Fato item pedido\Insight Frete e Rotas
		lineageTag: 42d193c0-7487-43d7-b1df-560332ecbb6d

	measure 'Custo por Kg da Rota Mais Cara' = ```

				VAR Ranking =
					ADDCOLUMNS(
						SUMMARIZE(fato_entrega, fato_entrega[rota]),
						"@CustoKg", [Custo por Quilo (por Rota)]
					)
				VAR Filtrado =
					FILTER(Ranking, NOT ISBLANK(fato_entrega[rota]) && [@CustoKg] > 0)
				RETURN
					MAXX(Filtrado, [@CustoKg])
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Fato item pedido\Insight Frete e Rotas
		lineageTag: b3d0a63c-7eb6-4131-ba7f-e4df760028ff

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Custo por Kg Médio (Top 10)' = ```

				VAR Top10 =
					TOPN(10, SUMMARIZE(fato_entrega, fato_entrega[rota]), [Valor de Frete], DESC)
				RETURN
					AVERAGEX(Top10, [Custo por Quilo (por Rota)])
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Fato item pedido\Insight Frete e Rotas
		lineageTag: 6e079a11-f622-462b-8914-bf8880635f59

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Múltiplo Custo por Kg' = ```

				DIVIDE(
					[Custo por Kg da Rota Mais Cara],
					[Custo por Kg Médio (Top 10)],
					0
				)
			```
		formatString: #,0.0"×"
		displayFolder: Fato item pedido\Insight Frete e Rotas
		lineageTag: d1d6e314-feb3-4877-a7fc-b0e1c0f8d644

	measure 'Insight Frete e Rotas' = ```

				"R$ " & FORMAT(DIVIDE([Valor de Frete], 1000000), "0,00") & "M em frete no período (" &
				FORMAT([Frete sobre Faturamento], "0,0%") & " do faturamento). A rota " &
				[Rota Mais Cara por Kg] & " é a mais cara por quilo — " &
				FORMAT([Custo por Kg da Rota Mais Cara], "\R\$ 0,00") & ", quase " &
				FORMAT([Múltiplo Custo por Kg], "0,0") & "× o custo das rotas de maior volume."
			```
		displayFolder: Fato item pedido\Insight Frete e Rotas
		lineageTag: 614d9a9a-3285-4334-add0-23a25554ac68

	measure 'Lead Time Médio Format' = FORMAT([Lead Time Médio], "#.0 Dias")
		isHidden
		displayFolder: Formatações
		lineageTag: db79e04f-d3f4-4e5c-98a4-31ea36b58ae1

		changedProperty = IsHidden

	measure 'Dias em Atraso (Format)' = FORMAT([Dias de Atraso (méd)], "#.0 Dias")
		isHidden
		displayFolder: Formatações
		lineageTag: b6455c3f-6860-4eca-b2ae-6c71ffe1126d

		changedProperty = IsHidden

	measure 'OTD % (Text Color)' =
			
			VAR vValor = [OTD %]
			
			RETURN
				SWITCH(
					TRUE(),
					vValor >= 0.95, "#047857",
					vValor >= 0.85, "#B45309",
					vValor <  0.85, "#B91C1C"
				)
		isHidden
		displayFolder: Formatações
		lineageTag: a679a618-24a0-42e1-8c23-cc7a5ce8fb97

		changedProperty = IsHidden

	measure 'OTD % (Background Color)' =
			
			VAR vValor = [OTD %]
			
			RETURN
				SWITCH(
					TRUE(),
					vValor >= 0.95, "#ECFDF5",
					vValor >= 0.85, "#FFFBEB",
					vValor <  0.85, "#FEF2F2"
				)
		isHidden
		displayFolder: Formatações
		lineageTag: 1badc47d-9b5a-4149-8402-5a6db4878591

		changedProperty = IsHidden

	measure 'Meta OTD' = 0.95
		isHidden
		displayFolder: Formatações
		lineageTag: d73f44fa-6a1a-45de-ad94-42ebdd417940

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OTD % (por Data de Entrega) — Rótulo Final' =
			
			VAR UltimoPontoComDados =
			    CALCULATE(
			        MAX(dim_calendario[sk_data]),
			        FILTER(
			            ALLSELECTED(dim_calendario),
			            NOT ISBLANK([OTD % (por Data de Entrega)])
			        )
			    )
			RETURN
			IF(
			    MAX(dim_calendario[sk_data]) = UltimoPontoComDados,
			    [OTD % (por Data de Entrega)],
			    BLANK()
			)
		isHidden
		displayFolder: Formatações
		lineageTag: 7fb26f18-43d1-4ded-b2b1-5502fc003af8

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OTD % (Legend)' =
			
			VAR vValor = [OTD %]
			
			RETURN
				SWITCH(
					TRUE(),
					vValor >= 0.95, "Bom!",
					vValor >= 0.85, "Atenção!",
					vValor <  0.85, "Crítico!"
				)
		isHidden
		displayFolder: Formatações
		lineageTag: 9137b9aa-740e-4078-8edd-d39acad907c5

		changedProperty = IsHidden

	partition _medidas = m
