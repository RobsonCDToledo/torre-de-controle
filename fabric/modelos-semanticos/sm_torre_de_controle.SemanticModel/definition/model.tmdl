model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - lh_gold","_medidas"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","TMDLView_Desktop","DevMode","RemoteModeling"]

ref table dim_calendario
ref table dim_vendedor
ref table dim_geografia
ref table dim_produto
ref table dim_cliente
ref table fato_entrega
ref table fato_item_pedido
ref table _medidas

ref role 'RLS - SP'
ref role 'RLS - RJ'

